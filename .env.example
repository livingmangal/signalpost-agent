# ==============================================================================
# Signalpost Agent: Free-Tier Environment Configuration
# All keys listed here are 100% FREE with NO credit card required.
# Copy this file to `.env` and paste any keys you register.
# ==============================================================================

# 1. Google Gemini API (Recommended for profile summaries - 10 points)
# Free tier: 15 requests/min, 1,500 requests/day
# Sign up free: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Brave Search API (Recommended for external search discovery)
# Free tier: 2,000 searches/month
# Sign up free: https://brave.com/search/api/
BRAVE_API_KEY=

# 3. Tavily Search API (Alternative/supplementary agentic search)
# Free tier: 1,000 searches/month
# Sign up free: https://tavily.com
TAVILY_API_KEY=

# 4. Groq API (Alternative high-speed free LLM: Llama 3.3 70B)
# Free tier: 30 requests/min
# Sign up free: https://console.groq.com
GROQ_API_KEY=

# 5. SerpAPI (Optional fallback Google search)
# Free tier: 100 searches/month
# Sign up free: https://serpapi.com
SERPAPI_API_KEY=
